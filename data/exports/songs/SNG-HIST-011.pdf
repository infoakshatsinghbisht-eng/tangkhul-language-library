0 -13 Td
/F1 9 Tf
(      "Vari raimaida, ali changthasa.") Tj
0 -13 Td
/F1 9 Tf
(      "Miwui vang aina thimaloda,") Tj
0 -13 Td
/F1 9 Tf
(      "Ali shitsangda ya jilakra.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Perfect submission, all is at rest,") Tj
0 -13 Td
/F1 9 Tf
(      "I in my Savior am happy and blest,") Tj
0 -13 Td
/F1 9 Tf
(      "Watching and waiting, looking above,") Tj
0 -13 Td
/F1 9 Tf
(      "Filled with His goodness, lost in His love.") Tj
