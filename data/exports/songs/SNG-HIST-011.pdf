(  [Stanza 2]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Ali shitsangda ringphamaithui,") Tj
0 -13 Td
/F1 9 Tf
(      "Hili ringshilala noda thaikui.") Tj
0 -13 Td
/F1 9 Tf
(      "Kachingli kada kachama malai,") Tj
0 -13 Td
/F1 9 Tf
(      "Makhanangmada ringphamang lai.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Perfect submission, perfect delight,") Tj
0 -13 Td
/F1 9 Tf
(      "Visions of rapture now burst on my sight;") Tj
0 -13 Td
/F1 9 Tf
(      "Angels, descending, bring from above") Tj
0 -13 Td
/F1 9 Tf
(      "Echoes of mercy, whispers of love.") Tj
0 -13 Td
/F1 8 Tf
