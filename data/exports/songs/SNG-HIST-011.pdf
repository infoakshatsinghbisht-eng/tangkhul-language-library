(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Ringkapha tui Jesu Amai!") Tj
0 -13 Td
/F1 9 Tf
(      "Arui ithumli laishida lai;") Tj
0 -13 Td
/F1 9 Tf
(      "Kahui samida ithum mahaira,") Tj
0 -13 Td
/F1 9 Tf
(      "Mangla kathara wukli changra.") Tj
0 -13 Td
/F1 9 Tf
(      "Chan hi iwaina, la hi phamei,") Tj
0 -13 Td
/F1 9 Tf
(      "Jesu amangli sochikatsa.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Blessed assurance, Jesus is mine!") Tj
0 -13 Td
/F1 9 Tf
(      "Oh, what a foretaste of glory divine!") Tj
0 -13 Td
/F1 9 Tf
(      "Heir of salvation, purchase of God,") Tj
0 -13 Td
/F1 9 Tf
(      "Born of His Spirit, washed in His blood.") Tj
0 -13 Td
/F1 9 Tf
(      "This is my story, this is my song,") Tj
0 -13 Td
/F1 9 Tf
(      "Praising my Savior all the day long.") Tj
0 -13 Td
/F1 8 Tf
( ) Tj
0 -12 Td
