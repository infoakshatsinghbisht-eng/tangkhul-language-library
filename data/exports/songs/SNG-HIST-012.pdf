(  [Stanza 1]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Arui ngayali ili ngachonlu,") Tj
0 -13 Td
/F1 9 Tf
(      "Tangmangtinghoda machihoalu.") Tj
0 -13 Td
/F1 9 Tf
(      "Kataina mangachonlala Amai,") Tj
0 -13 Td
/F1 9 Tf
(      "Nana ngachonrada, ithumna thai.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Abide with me, fast falls the eventide;") Tj
0 -13 Td
/F1 9 Tf
(      "The darkness deepens, Lord, with me abide.") Tj
0 -13 Td
/F1 9 Tf
(      "When other helpers fail and comforts flee,") Tj
0 -13 Td
/F1 9 Tf
(      "Help of the helpless, oh, abide with me.") Tj
0 -13 Td
/F1 8 Tf
( ) Tj
0 -12 Td
/F2 10 Tf
(  [Stanza 2]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Okkathui hi kashanaka pamli,") Tj
0 -13 Td
/F1 9 Tf
(      "Ringkapha teoda thakta shimanli.") Tj
0 -13 Td
/F1 9 Tf
(      "Mikumo pamli kashiman mang lai,") Tj
0 -13 Td
/F1 9 Tf
(      "Na makashiman ishachaina.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Swift to its close ebbs out life's little day;") Tj
0 -13 Td
/F1 9 Tf
(      "Earth's joys grow dim, its glories pass away;") Tj
0 -13 Td
/F1 9 Tf
(      "Change and decay in all around I see;") Tj
0 -13 Td
/F1 9 Tf
(      "O Thou who changest not, abide with me.") Tj
0 -13 Td
/F1 8 Tf
( ) Tj
0 -12 Td
/F2 10 Tf
(  [Stanza 3]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Kharargida ili maraahi,") Tj
0 -13 Td
/F1 9 Tf
(      "Lumashenda ili kharamihi;") Tj
0 -13 Td
/F1 9 Tf
(      "Kakhanang thaida laishimaikapa,") Tj
0 -13 Td
/F1 9 Tf
(      "Ishamai nana phamaikaplaka.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Not a brief glance I beg, a passing word,") Tj
0 -13 Td
/F1 9 Tf
(      "But as Thou dwell'st with Thy disciples, Lord,") Tj
0 -13 Td
/F1 9 Tf
(      "Familiar, condescending, patient, free.") Tj
0 -13 Td
/F1 9 Tf
(      "Come not to sojourn, but abide with me.") Tj
0 -13 Td
/F1 8 Tf
( ) Tj
0 -12 Td
