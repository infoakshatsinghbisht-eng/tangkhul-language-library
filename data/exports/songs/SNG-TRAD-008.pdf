(  [Stanza 1]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Itang rakhongli, Ayisho yaota rarali,") Tj
0 -13 Td
/F1 9 Tf
(      "Ayisho, yaota rarali.") Tj
0 -13 Td
/F1 9 Tf
(      "Kongrei khanganu wui ngaloong pamei,") Tj
0 -13 Td
/F1 9 Tf
(      "I-wui ningli leikashi thot leisai.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Along the riverbanks of our village, gazing far into the distant hills,") Tj
0 -13 Td
/F1 9 Tf
(      "O beloved, looking far across the valleys.") Tj
0 -13 Td
/F1 9 Tf
(      "Beside the clear murmuring waters and sacred ancient stones,") Tj
0 -13 Td
/F1 9 Tf
(      "In my heart, the deepest love of our youth abides.") Tj
0 -13 Td
/F1 8 Tf
( ) Tj
0 -12 Td
/F2 10 Tf
(  [Stanza 2]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Imak oh khavamkhui milu,") Tj
0 -13 Td
/F1 9 Tf
(      "Imak oh mavamkhui thu-a.") Tj
0 -13 Td
/F1 9 Tf
(      "Leikashi kaphung kanhaira,") Tj
0 -13 Td
/F1 9 Tf
(      "Kaphungchi khanemta milu.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "O mother, let not our tearful eyes be dimmed by distance,") Tj
0 -13 Td
/F1 9 Tf
(      "Let not sorrow cloud the vision of our eyes.") Tj
0 -13 Td
/F1 9 Tf
(      "The beloved mountain ridge rises tall between us,") Tj
0 -13 Td
/F1 9 Tf
(      "O gentle peaks, lower yourselves down that I may gaze upon my love!") Tj
0 -13 Td
/F1 8 Tf
( ) Tj
0 -12 Td
/F2 10 Tf
(  [Stanza 3]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Leikashi ram ngashanvaika,") Tj
0 -13 Td
/F1 9 Tf
(      "Iram Hunphun wui won kapha.") Tj
0 -13 Td
/F1 9 Tf
(      "Ningkachang wui tui khamata,") Tj
0 -13 Td
/F1 9 Tf
(      "Thot kachungli mashimanmana.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "That our eyes may catch a glimpse of our beloved homeland,") Tj
0 -13 Td
/F1 9 Tf
(      "The fairest blossom blooming on the slopes of Hunphun.") Tj
0 -13 Td
/F1 9 Tf
(      "The sacred promise whispered in mutual longing,") Tj
0 -13 Td
/F1 9 Tf
(      "Shall never perish through the passing of generations.") Tj
0 -13 Td
/F1 8 Tf
