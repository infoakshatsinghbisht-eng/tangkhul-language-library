(  [Stanza 2]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Arai a-wung wui ngashan kashak,") Tj
0 -13 Td
/F1 9 Tf
(      "Changvai pheishak aina ngachee.") Tj
0 -13 Td
/F1 9 Tf
(      "Khamatei raipam ngatei kazingli,") Tj
0 -13 Td
/F1 9 Tf
(      "Iram wui mashun themthot pamei.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Bearing the regal customs and nobility of our ancestral chiefs,") Tj
0 -13 Td
/F1 9 Tf
(      "Shield and spear gleaming in ceremonial defense.") Tj
0 -13 Td
/F1 9 Tf
(      "Against all adversities and neighboring perils,") Tj
0 -13 Td
/F1 9 Tf
(      "The honor and righteousness of our people stand unshakable.") Tj
0 -13 Td
/F1 8 Tf
