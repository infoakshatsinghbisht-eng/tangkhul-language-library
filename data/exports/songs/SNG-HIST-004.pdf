(  [Stanza 1]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "He Jesuwui makali, Ringphalaka;") Tj
0 -13 Td
/F1 9 Tf
(      "Awui ngahan ngaida romhai, Phasa kakhanang rai.") Tj
0 -13 Td
/F1 9 Tf
(      "Kachingwui chan nganalu, Iwui la sada laili,") Tj
0 -13 Td
/F1 9 Tf
(      "Jesuna nani mashitta, Hangda la kasana.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Safe in the arms of Jesus, safe on His gentle breast;") Tj
0 -13 Td
/F1 9 Tf
(      "There by His love o'ershadowed, sweetly my soul shall rest.") Tj
0 -13 Td
/F1 9 Tf
(      "Hark, 'tis the voice of angels, borne in a song to me,") Tj
0 -13 Td
/F1 9 Tf
(      "Over the fields of glory, over the jasper sea.") Tj
0 -13 Td
/F1 8 Tf
( ) Tj
0 -12 Td
/F2 10 Tf
(  [Stanza 2]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "He Jesuwui makali, Kangachee malaimana,") Tj
0 -13 Td
/F1 9 Tf
(      "I morai maphungmara, Chiaina makhanangmara.") Tj
0 -13 Td
/F1 9 Tf
(      "Wukli kakhanang malaita, Ringkapha apamna,") Tj
0 -13 Td
/F1 9 Tf
(      "Mikumo awui okkathui, Makaphawui zatna.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Safe in the arms of Jesus, safe from corroding care;") Tj
0 -13 Td
/F1 9 Tf
(      "Free from the blights of sorrow, free from the tempter's snare.") Tj
0 -13 Td
/F1 9 Tf
(      "Free from the doubts and conflicts, in that blissful realm above,") Tj
0 -13 Td
/F1 9 Tf
(      "Where mortal grief and sin no more can sever us from love.") Tj
0 -13 Td
/F1 8 Tf
