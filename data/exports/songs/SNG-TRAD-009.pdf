0 -15 Td
/F2 10 Tf
(  [Stanza 1]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Yarra phanit kathi-li kaphung ngasan,") Tj
0 -13 Td
/F1 9 Tf
(      "Yarshung mayarnaomaya wui khararchan.") Tj
0 -13 Td
/F1 9 Tf
(      "Sikui kazing thota won kapha khawon,") Tj
0 -13 Td
/F1 9 Tf
(      "Iram Hungpungli ningyang pamei.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "At the return of Yarra spring festival, the mountain hills awake,") Tj
0 -13 Td
/F1 9 Tf
(      "The youthful maidens and young men gather to share their stories.") Tj
0 -13 Td
/F1 9 Tf
(      "Wild berries ripen in the warmth of the mountain breeze,") Tj
0 -13 Td
/F1 9 Tf
(      "In our Hungpung village, youthful delight abounds.") Tj
0 -13 Td
/F1 8 Tf
( ) Tj
0 -12 Td
/F2 10 Tf
(  [Stanza 2]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Lui thot mashakpa rui thot kasa,") Tj
0 -13 Td
/F1 9 Tf
(      "Khangrei longshimli tui khangasak.") Tj
0 -13 Td
/F1 9 Tf
(      "Phanit wui kongrei mathi kazing,") Tj
0 -13 Td
/F1 9 Tf
(      "Ngalalao thotli leishat khayao.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Before the heavy ploughing and seasonal toil begin,") Tj
0 -13 Td
/F1 9 Tf
(      "Voices resonate within the halls of the traditional youth dormitory.") Tj
0 -13 Td
/F1 9 Tf
(      "Like mountain rivers flowing pure beneath the spring sky,") Tj
0 -13 Td
/F1 9 Tf
(      "Love and mutual admiration blossom among the youth.") Tj
0 -13 Td
/F1 8 Tf
( ) Tj
0 -12 Td
/F2 10 Tf
(  [Stanza 3]) Tj
0 -14 Td
/F1 9 Tf
(    Tangkhul Verses:) Tj
0 -13 Td
/F1 9 Tf
(      "Achanwon kachi ramwui shanaora,") Tj
0 -13 Td
/F1 9 Tf
(      "Mayar ngalanao wui ringkapha laa.") Tj
0 -13 Td
/F1 9 Tf
(      "Varewui ningli kashak thotna,") Tj
0 -13 Td
/F1 9 Tf
(      "Yarra wui pheichak ngasa-ngahei.") Tj
0 -13 Td
/F1 9 Tf
(    English Gloss:) Tj
0 -13 Td
/F1 9 Tf
(      "Beloved daughters of our ancestral villages,") Tj
0 -13 Td
/F1 9 Tf
(      "Singing songs of youthful strength and boundless joy.") Tj
0 -13 Td
/F1 9 Tf
(      "Under the watchful blessing of the divine Creator,") Tj
0 -13 Td
/F1 9 Tf
(      "We dance together in the graceful steps of Yarra.") Tj
