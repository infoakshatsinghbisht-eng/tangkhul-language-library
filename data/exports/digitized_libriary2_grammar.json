{
  "noun_gender": {
    "description": "Tangkhul distinguishes natural gender for human beings and animals using specific suffixes.",
    "human_gender_suffixes": {
      "masculine": "-a / mayara",
      "feminine": "-va / ngalava"
    },
    "animal_gender_suffixes": {
      "masculine": "-vā (e.g. Fa-vā: male dog)",
      "feminine": "-lā / -vā (e.g. Fa-lā: female dog)"
    },
    "examples": [
      {
        "tangkhul_masc": "Ngasotnao mayara",
        "tangkhul_fem": "Ngasotnao ngalava",
        "english": "Friend (male / female)",
        "hindi": "मित्र / सहेली"
      },
      {
        "tangkhul_masc": "Yaron-a",
        "tangkhul_fem": "Laron-a",
        "english": "Bachelor / Spinster",
        "hindi": "कुँवारा / कुँवारी"
      },
      {
        "tangkhul_masc": "Awun-a",
        "tangkhul_fem": "Phila-va",
        "english": "Chief / Chieftess",
        "hindi": "मुखिया / मुखियाइन"
      },
      {
        "tangkhul_masc": "Sigui a-vā",
        "tangkhul_fem": "Sigui a-lā",
        "english": "Stallion / Mare",
        "hindi": "घोड़ा / घोड़ी"
      },
      {
        "tangkhul_masc": "Fa-vā",
        "tangkhul_fem": "Fa-lā",
        "english": "Dog (male) / Bitch (female)",
        "hindi": "कुत्ता / कुतिया"
      },
      {
        "tangkhul_masc": "Har-va",
        "tangkhul_fem": "Har-va / Har-la",
        "english": "Rooster / Hen",
        "hindi": "मुर्गा / मुर्गी"
      }
    ]
  },
  "case_markers": {
    "description": "Postpositional case markers attached to nouns and pronouns.",
    "cases": [
      {
        "case": "Nominative (कर्ता)",
        "marker": "-na",
        "function": "Agent of transitive/intransitive verb",
        "example": "I-na zat-ra (I will go / मैं जाऊँगा)"
      },
      {
        "case": "Accusative (कर्म)",
        "marker": "-li",
        "function": "Direct/indirect human object",
        "example": "A-na i-li leishi (He loves me / वह मुझे प्रेम करता है)"
      },
      {
        "case": "Instrumental (करण)",
        "marker": "-eina",
        "function": "Instrument, means, or from",
        "example": "Pang eina kasa (Made by hand / हाथ से बनाया गया)"
      },
      {
        "case": "Dative (संप्रदान)",
        "marker": "-li / -wui vang",
        "function": "For, towards, to the benefit of",
        "example": "I-wui vang (For me / मेरे लिए)"
      },
      {
        "case": "Ablative (अपादान)",
        "marker": "-wui eina",
        "function": "Source or separation",
        "example": "Ukhrul wui eina (From Ukhrul / उखरुल से)"
      },
      {
        "case": "Genitive (संबंध)",
        "marker": "-wui",
        "function": "Possession (of, 's)",
        "example": "I-wui aming (My name / मेरा नाम)"
      },
      {
        "case": "Locative (अधिकरण)",
        "marker": "-li",
        "function": "In, at, on location",
        "example": "Shim-li pam (Stay at home / घर में रहना)"
      }
    ]
  },
