  "verb_tenses": {
    "description": "Verbal tense and aspect morphology in Tangkhul Naga.",
    "tenses": [
      {
        "tense": "Present Continuous / Progressive (अपूर्ण वर्तमान)",
        "marker": "-bam",
        "example": {
          "tangkhul": "I zat-bam-me",
          "english": "I am going",
          "hindi": "मैं जा रहा हूँ"
        }
      },
      {
        "tense": "Past Tense (भूतकाल)",
        "marker": "-sai / -haira",
        "example": {
          "tangkhul": "I zat-sai",
          "english": "I went",
          "hindi": "मैं गया / गई"
        }
      },
      {
        "tense": "Completive Past (पूर्ण भूतकाल)",
        "marker": "-haira",
        "example": {
          "tangkhul": "Maphazahaira",
          "english": "Have eaten / Finished eating",
          "hindi": "खाना खा लिया है"
        }
      },
      {
        "tense": "Future Tense (भविष्यत काल)",
        "marker": "-ra / -ga",
        "example": {
          "tangkhul": "I zat-ra",
          "english": "I will go",
          "hindi": "मैं जाऊँगा / जाऊँगी"
        }
      },
      {
        "tense": "Negative Form (नकारात्मक)",
        "marker": "Prefix ma- + verb root + -mana",
        "example": {
          "tangkhul": "I ma-zat-mana",
          "english": "I do not go",
          "hindi": "मैं नहीं जाता हूँ"
        }
      },
      {
        "tense": "Imperative (आज्ञार्थक)",
        "marker": "-lu (polite) / -lo",
        "example": {
          "tangkhul": "Zat-lu!",
          "english": "Go!",
          "hindi": "जाओ! / जाइए!"
        }
      }
    ]
  },
  "syntax": {
    "word_order": "SOV (Subject - Object - Verb)",
    "description": "Tangkhul Naga strictly adheres to the Subject-Object-Verb word order, identical to Hindi and Japanese.",
    "example": {
      "tangkhul": "I-na tara mang-ra",
      "literal": "I (Subject) + water (Object) + will drink (Verb)",
      "english": "I will drink water",
      "hindi": "मैं पानी पीऊँगा (कर्ता + कर्म + क्रिया)"
    }
  }
}