    "3_traditional_measurements": {
      "linear_measures": [
        {
          "term": "Phei-kanao amik",
          "meaning_en": "Finger-width",
          "meaning_hi": "उँगली की चौड़ाई",
          "usage": "Measuring thickness of woven shawls, cane strips, and arrow shafts."
        },
